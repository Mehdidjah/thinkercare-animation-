# ──────────────────────────────────────────────────────────────
# Dependencies & build output — regenerated by `bun install` /
# `vite build`; never commit. (Matches these dirs at any depth.)
# ──────────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
.output/
.nitro/
.vinxi/
.tanstack/
.vite/
*.local

# Wrangler / Cloudflare local state
.wrangler/
.dev.vars

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Secrets / local env — never commit
.env
.env.*
!.env.example

# OS / editor junk
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.sw?

# ──────────────────────────────────────────────────────────────
# Backup / archive dossier — kept on disk, excluded from version
# control. None of this affects how the app builds or runs; it is
# the handover snapshot (DB export, media, audit, history, docs).
# See 00_LIRE_EN_PREMIER.md. Anchored with "/" = repo root only.
# ──────────────────────────────────────────────────────────────
/02_historique/
/03_donnees/
/04_medias_catalogue/
/05_medias_prives/
/06_audit/
/07_documentation/
/SHA256SUMS.txt
/verifier_dossier.py
