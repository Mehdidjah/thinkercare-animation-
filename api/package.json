{
  "name": "thinkercare-terrain-api",
  "version": "1.0.0",
  "private": true,
  "description": "ThinkerCare Terrain backend — NestJS + Drizzle + Postgres (Railway)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js",
    "seed": "node dist/db/seed.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:passwords": "bun test test/passwords.test.ts",
    "test:uploads": "bun test test/photo-body.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.705.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.38.4",
    "express": "^5.1.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.2"
  }
}
