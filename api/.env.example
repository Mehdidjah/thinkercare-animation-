# ThinkerCare Terrain API — environment variables.
# At boot the server logs a "[config]" report: a missing DATABASE_URL stops it;
# every other problem below is logged as an error or warning (never the values).

# --- Required ---
# Railway Postgres connection string (the Postgres plugin provides this).
DATABASE_URL=postgres://user:pass@host:5432/railway
# Initial admin password (hashed; never reapplied to an existing account).
ADMIN_INITIAL_PASSWORD=change-me-strong-passphrase
# 32 random bytes encoded as 64 hex characters, stored only in the secret store.
# Required for saving/revealing non-admin passwords, and signs the "known
# browser" login cookie. Back up and retain this key across deployments;
# replacing it makes existing encrypted copies unreadable.
# Generate with: openssl rand -hex 32 (never commit the output).
ACCOUNT_PASSWORD_KEY=
# Extra allowed origins for the CSRF/origin check on POST, comma-separated bare
# origins (scheme://host, no path). The service's own host is always allowed;
# list the Vercel front-end domains here or every POST through Vercel gets 403.
APP_ORIGIN=https://your-app.vercel.app
# Recommended: the public front end (bare https origin). Pages opened on this
# service's own Railway URL are redirected there; /api and /healthz are not.
# PUBLIC_APP_URL=https://your-app.vercel.app

# --- Photo storage (required: check-in and check-out need a photo) ---
# Pick ONE backend. Without one, every photo upload, check-in and check-out
# answers 503 "Stockage indisponible".
#
# Option A (production) — Railway volume. Attach a volume to the service with
# mount path /data, then set:
STORAGE_DIR=/data
#
# Option B — S3-compatible (Cloudflare R2 / AWS S3 / Backblaze / MinIO). Set all
# of S3_BUCKET, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY (S3 then wins over
# STORAGE_DIR); a partial set is reported at boot and ignored.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=thinkercare-terrain
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Recommended ---
NODE_ENV=production
# PORT is injected by Railway; defaults to 3000 locally.

# --- Optional test accounts: created only when a password is explicitly set ---
# Use unique strong passwords. Existing accounts are always preserved.
SEED_MANAGER_PASSWORD=
SEED_FIELD_PASSWORD=
SEED_DOCTOR_PASSWORD=
# Set to 1 to seed the two demo stores. Off by default (leave it unset on
# Railway); existing rows are never touched or deleted either way.
SEED_DEMO_DATA=

# --- Healthcheck ---
# GET /healthz answers 200 {"ok":true} when Postgres answers "SELECT 1", else
# 503. railway.json points Railway's deploy healthcheck at it.

# --- Advanced (optional) ---
# PG_POOL_MAX=10
# Per-statement cap for the app's queries, in ms (0 disables). The boot
# migration always runs without it.
# PG_STATEMENT_TIMEOUT_MS=30000
# DATABASE_SSL=false      # disable TLS (local Postgres)
# STATIC_DIR=/abs/path/to/app/dist
