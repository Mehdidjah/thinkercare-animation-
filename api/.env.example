# ThinkerCare Terrain API — environment variables.

# --- Required ---
# Railway Postgres connection string (the Postgres plugin provides this).
DATABASE_URL=postgres://user:pass@host:5432/railway
# Initial admin password (seed hashes it; admin must change it at first login).
ADMIN_INITIAL_PASSWORD=change-me-strong-passphrase
# Canonical public origin, used for the CSRF/origin check on POST.
# e.g. https://thinkercare.up.railway.app
APP_ORIGIN=https://your-app.up.railway.app

# --- Recommended ---
NODE_ENV=production
# PORT is injected by Railway; defaults to 3000 locally.

# --- Test-account passwords (seed; optional, documented defaults used if unset) ---
SEED_MANAGER_PASSWORD=Gestion-Terrain-2026
SEED_FIELD_PASSWORD=Animatrice-Terrain-2026
SEED_DOCTOR_PASSWORD=Medecin-Terrain-2026

# --- S3-compatible photo storage (optional) ---
# If unset, photo upload/get endpoints return 503 "Stockage indisponible"; the
# rest of the app (dashboard, scheduling, stock, sales) works without it.
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=thinkercare-terrain
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Advanced (optional) ---
# PG_POOL_MAX=10
# DATABASE_SSL=false      # disable TLS (local Postgres)
# STATIC_DIR=/abs/path/to/app/dist
