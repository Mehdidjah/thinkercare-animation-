{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      { "include": "db/triggers.sql", "outDir": "dist" },
      { "include": "db/catalogue.json", "outDir": "dist" }
    ],
    "watchAssets": false
  }
}
